rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

  function isAdmin() {
    return request.auth != null && (
      request.auth.token.email == 'linlilung@gmail.com' ||
      request.auth.token.email == 'linleelung@gmail.com'
    );
  }

  match /users/{userId} {
  // 所有登入者可讀，本人或管理員可寫
  allow read: if request.auth != null;
  allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
}
    // ✅ 可讀寫 quotes（任意使用者）
    match /quotes/{docId} {
      allow read, write: if request.auth != null;
    }

    // ✅ 工地估價單
    match /siteQuotes/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
