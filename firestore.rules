rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

  match /users/{userId} {
  // ✅ 所有人可讀，僅本人可寫
  allow read: if request.auth != null;
  allow write: if request.auth != null && request.auth.uid == userId;
}
    // ✅ 可讀寫 quotes（任意使用者）
    match /quotes/{docId} {
      allow read, write: if request.auth != null;
    }
    match /quotes/{docId} {
      allow read 
    }
  }
}
